DATABASE_URL="postgresql://postgres:postgres@localhost:5432/d3crm?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Publish verified operator details before opening production registration.
# These are public notices, never secrets. Production registration fails closed if incomplete.
LEGAL_OPERATOR_NAME=""
LEGAL_OPERATOR_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_GRIEVANCE_CONTACT=""
# Name actual hosting/database/backup providers and their processing countries, including support access.
LEGAL_INFRASTRUCTURE_PROVIDERS=""
LEGAL_PROCESSING_LOCATIONS=""

# Resend: verify the sending domain before enabling account email and alerts.
RESEND_API_KEY=""
MAIL_FROM="d3CRM <notifications@example.com>"

# Schedule POST /api/jobs/deliveries every minute with Authorization: Bearer CRON_SECRET.
CRON_SECRET="replace-with-another-openssl-rand-base64-32"

# Set only if your proxy overwrites this header and the app cannot be reached around it.
# An empty value uses shared rate-limit buckets and ignores forwarded IP headers.
TRUSTED_IP_HEADER=""

# Billing stays off until the keys, recurring price, webhook, and portal are configured.
BILLING_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
FREE_FORM_LIMIT="3"
FREE_SUBMISSION_LIMIT="100"
PRO_FORM_LIMIT="50"
PRO_SUBMISSION_LIMIT="5000"
