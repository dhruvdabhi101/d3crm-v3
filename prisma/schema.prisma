generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  emailVerifiedAt     DateTime?
  sessionVersion      Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         OrganizationMember[]
  tokens              AccountToken[]
  assignedSubmissions Submission[]
  notes               SubmissionNote[]
}

model Organization {
  // Normalized name uniqueness is enforced by the 20260924000000 SQL migration.
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  members              OrganizationMember[]
  forms                Form[]
  invitations          Invitation[]
  plan                 Plan                 @default(FREE)
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  stripeCheckoutId     String?
  subscriptionStatus   String?
  usageMonth           DateTime             @default(now())
  monthlySubmissions   Int                  @default(0)
}

model OrganizationMember {
  // The 20260924000000 SQL migration permits one OWNER per organization.
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Form {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  status             FormStatus         @default(LIVE)
  schema             Json               @db.JsonB
  schemaVersion      Int                @default(1)
  allowedOrigins     String[]           @default([])
  notificationEmails String[]           @default([])
  webhookUrl         String?
  webhookSecret      String?
  keyPrefix          String
  keyHash            String             @unique
  organizationId     String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  deliveries         OutboundDelivery[]

  @@index([organizationId, createdAt])
}

model Submission {
  id                 String             @id @default(cuid())
  data               Json               @db.JsonB
  schemaSnapshot     Json?              @db.JsonB
  status             LeadStatus         @default(NEW)
  readAt             DateTime?
  assigneeId         String?
  followUpAt         DateTime?
  followUpNotifiedAt DateTime?
  updatedAt          DateTime           @default(now()) @updatedAt
  assignee           User?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notes              SubmissionNote[]
  deliveries         OutboundDelivery[]
  sourceOrigin       String?
  userAgent          String?
  ipHash             String?
  formId             String
  createdAt          DateTime           @default(now())
  form               Form               @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([formId, ipHash, createdAt])
  @@index([formId, status, createdAt])
}

model SubmissionNote {
  id           String     @id @default(cuid())
  body         String
  submissionId String
  authorId     String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model AccountToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model OutboundDelivery {
  id            String         @id @default(cuid())
  kind          DeliveryKind
  payload       Json           @db.JsonB
  formId        String?
  submissionId  String?
  submission    Submission?    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  form          Form?          @relation(fields: [formId], references: [id], onDelete: Cascade)
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  leaseUntil    DateTime?
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([formId, createdAt])
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

enum Plan {
  FREE
  PRO
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  SPAM
}

enum DeliveryKind {
  EMAIL
  WEBHOOK
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum FormStatus {
  DRAFT
  LIVE
  ARCHIVED
}
