{
  "name": "d3crm-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:generate && pnpm db:deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types lib/**/*.test.ts",
    "test:integration": "node --env-file=.env.test --experimental-strip-types scripts/integration.test.ts",
    "test:migrations": "node --experimental-strip-types scripts/migration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "0.544.0",
    "next": "15.5.27",
    "next-auth": "4.24.15",
    "radix-ui": "^1.7.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.26",
    "prisma": "6.19.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
